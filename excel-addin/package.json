{
  "name": "precis-excel-addin",
  "version": "0.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/precis-finance/precis-finance-mcp.git",
    "directory": "excel-addin"
  },
  "license": "Elastic-2.0",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "dev-server": "webpack serve --mode development",
    "lint": "office-addin-lint check",
    "lint:fix": "office-addin-lint fix",
    "prestart": "npm run build",
    "prettier": "office-addin-lint prettier",
    "signin": "office-addin-dev-settings m365-account login",
    "signout": "office-addin-dev-settings m365-account logout",
    "start": "office-addin-debugging start manifest.xml",
    "stop": "office-addin-debugging stop manifest.xml",
    "validate": "office-addin-manifest validate manifest.xml",
    "watch": "webpack --mode development --watch"
  },
  "dependencies": {
    "core-js": "^3.36.0",
    "regenerator-runtime": "^0.14.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-typescript": "^7.23.3",
    "@types/custom-functions-runtime": "^1.6.8",
    "@types/office-js": "^1.0.377",
    "@types/office-runtime": "^1.0.35",
    "@typescript-eslint/parser": "^8.72.1",
    "acorn": "^8.5.0",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^14.0.0",
    "custom-functions-metadata-plugin": "^2.1.2",
    "eslint-plugin-office-addins": "^5.0.1",
    "file-loader": "^6.2.0",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.0",
    "office-addin-cli": "^3.0.1",
    "office-addin-debugging": "^7.0.1",
    "office-addin-dev-certs": "^3.0.1",
    "office-addin-dev-settings": "^4.0.1",
    "office-addin-lint": "^4.0.1",
    "office-addin-manifest": "^3.0.1",
    "office-addin-prettier-config": "^3.0.1",
    "os-browserify": "^0.3.0",
    "process": "^0.11.10",
    "source-map-loader": "^5.0.0",
    "typescript": "^5.4.2",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^6.1.0"
  },
  "prettier": "office-addin-prettier-config",
  "browserslist": [
    "last 2 versions",
    "ie 11"
  ],
  "overrides": {
    "minimatch@>=10.2.2 <11": "^11.0.1",
    "glob@13.0.6": {
      "minimatch": "^10.2.6"
    }
  }
}
